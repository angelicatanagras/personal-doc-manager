# Server
PORT=5000

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/document-manager?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_here

# File Storage
# Uploaded files are stored in backend/uploads/ (local disk, gitignored)
# Max file size: 50 MB
# Allowed types: PDF, JPG, PNG, DOCX, XLSX

# GitHub Actions Secrets (set in repo Settings → Environments → production)
# EC2_HOST      — EC2 public IP address
# EC2_USER      — ubuntu
# EC2_SSH_KEY   — contents of your .pem key file
# MONGO_URI     — same as above
# JWT_SECRET    — same as above
